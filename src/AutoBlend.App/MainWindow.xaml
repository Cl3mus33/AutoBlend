<Window x:Class="AutoBlend.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutoBlend.App.ViewModels"
        mc:Ignorable="d"
        Title="AutoBlend" Height="860" Width="600" MinHeight="500" MinWidth="480" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>

        <!-- Header — flat green + pie-style icon, matching AutoSeasons' visual identity -->
        <Border DockPanel.Dock="Top" Padding="16,14" Background="{StaticResource AccentBrush}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="22" Height="22" Margin="0,0,10,0">
                    <Grid.Clip>
                        <EllipseGeometry Center="11,11" RadiusX="11" RadiusY="11"/>
                    </Grid.Clip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#FFC107"/>
                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#66BB6A"/>
                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#FF7043"/>
                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#29B6F6"/>
                </Grid>
                <TextBlock Text="AutoBlend" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Footer — mirrors AutoSeasons: progress bar, expandable "Show details" log, and a
             single action button whose label/behavior changes from "Start Patching" to
             "Done - Close" / "Failed - Close" once the run finishes, instead of auto-closing. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackgroundBrush}" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <ProgressBar Margin="0,0,0,8"
                             Minimum="0"
                             Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding ProgressIsIndeterminate}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Border Visibility="{Binding ShowDetails, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        MaxHeight="160" Margin="0,0,0,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DetailLines}" Margin="8,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" Margin="0"/>
                        <Button Content="Show details" Margin="10,0,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource AccentBrush}" Cursor="Hand" Command="{Binding ToggleDetailsCommand}"
                                Visibility="{Binding HasStarted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Width="90" Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
                        <Button Width="140" Command="{Binding PrimaryActionCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Content" Value="Start Patching"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCompleted}" Value="True">
                                            <Setter Property="Content" Value="Done - Close"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasCompleted}" Value="True"/>
                                                <Condition Binding="{Binding HasFailed}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Content" Value="Failed - Close"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TabControl Margin="12,12,12,0">

            <!-- ===================== GENERAL TAB ===================== -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">

                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,14">
                        Scans your load order for landscape statics/blending texture variants
                        (e.g. textures\landscape\statics\dirt02.dds next to textures\landscape\dirt02.dds)
                        and generates patched meshes + a plugin assigning the derived TextureSets.
                    </TextBlock>

                    <TextBlock Text="Game Location" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding GameLocation, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse" Width="90" Command="{Binding BrowseGameLocationCommand}"/>
                    </Grid>

                    <TextBlock Text="Game Type" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <ComboBox ItemsSource="{Binding GameTypes}" SelectedItem="{Binding GameType}" HorizontalAlignment="Left" Width="200"/>

                    <TextBlock Text="Output Location" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding OutputLocation, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse" Width="90" Command="{Binding BrowseOutputLocationCommand}"/>
                    </Grid>

                    <TextBlock Text="Mod Manager" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Style="{StaticResource HintTextStyle}">
                        Vortex's default deployment already merges mods into Data, same as a manual install — pick None.
                        Mod Organizer 2 keeps mods in separate folders behind a virtual file system, so its instance
                        needs to be read directly to see them.
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding ModManagerOptions}"
                              SelectedValue="{Binding ModManager}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              HorizontalAlignment="Left" Width="200"/>

                    <StackPanel Visibility="{Binding ModManager, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=ModOrganizer2}">
                        <TextBlock Text="MO2 Instance Path" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}">
                            Root of the MO2 instance — the folder containing "mods", "profiles", and "overwrite".
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Mo2InstancePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse" Width="90" Command="{Binding BrowseMo2InstancePathCommand}"/>
                        </Grid>

                        <TextBlock Text="MO2 Profile" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}">
                            Auto-filled from MO2's currently active profile when you set the instance path above — only
                            change this if you want to target a different profile.
                        </TextBlock>
                        <TextBox Text="{Binding Mo2ProfileName, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="200"/>
                    </StackPanel>

                    <TextBlock Text="TextureSet Naming Template" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <TextBlock Style="{StaticResource HintTextStyle}">
                        Tokens: {Type} resolves to the matching folder's Type Label below, {Name} is the source vanilla TextureSet EditorID.
                    </TextBlock>
                    <TextBox Text="{Binding TextureSetNamingTemplate, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="260"/>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== OPTIONS TAB ===================== -->
            <TabItem Header="Options">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">

                        <TextBlock Text="Landscape Folder Names" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}">
                            Any of these sub-folder names, found next to a landscape texture under a "*\landscape\" path
                            (base game, DLC, or mods), triggers the alpha blending patch for meshes/records using that texture.
                            The Type Label feeds the {Type} token in the naming template above.
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding LandscapeFolderRules}"
                                  SelectedItem="{Binding SelectedLandscapeFolderRule}"
                                  Height="110">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Folder Name" Binding="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Type Label" Binding="{Binding TypeLabel, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Add Row" Width="90" Margin="0,0,8,0" Command="{Binding AddLandscapeFolderRuleCommand}"/>
                            <Button Content="Remove Row" Width="100" Command="{Binding RemoveLandscapeFolderRuleCommand}"/>
                        </StackPanel>

                        <TextBlock Text="Mesh Blacklist" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}">
                            Meshes matching a wildcard pattern here are skipped entirely, even if otherwise in scope
                            (e.g. glass/ice statics where alpha testing is intentional). Wildcards (*) allowed, e.g. "*\glass\*".
                        </TextBlock>
                        <ListBox ItemsSource="{Binding MeshBlacklist}" SelectedItem="{Binding SelectedMeshBlacklistEntry}" Height="90"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewMeshBlacklistEntry, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Add" Width="70" Margin="0,0,8,0" Command="{Binding AddMeshBlacklistEntryCommand}"/>
                            <Button Grid.Column="2" Content="Remove" Width="80" Command="{Binding RemoveMeshBlacklistEntryCommand}"/>
                        </Grid>

                        <TextBlock Text="EditorID Blacklist Keywords" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}">
                            Records whose EditorID contains one of these words (case-insensitive) are skipped by the
                            blending patch entirely.
                        </TextBlock>
                        <ListBox ItemsSource="{Binding EditorIdBlacklistKeywords}" SelectedItem="{Binding SelectedEditorIdKeyword}" Height="90"/>
                        <Grid Margin="0,6,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewEditorIdKeyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Add" Width="70" Margin="0,0,8,0" Command="{Binding AddEditorIdKeywordCommand}"/>
                            <Button Grid.Column="2" Content="Remove" Width="80" Command="{Binding RemoveEditorIdKeywordCommand}"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
